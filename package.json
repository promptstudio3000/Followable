{
  "name": "followable-hidden-location-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "node -e \"const fs=require('fs');const p='.next';if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true});\"",
    "dev": "node scripts/clear-next-lock.mjs && next dev --webpack -H 0.0.0.0 -p ${PORT:-3007}",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true});\" && npm run dev",
    "dev:turbo": "next dev -H 0.0.0.0 -p ${PORT:-3007}",
    "dev:demo": "USE_DEMO_MODE=true next dev --webpack -H 0.0.0.0 -p 3007",
    "build": "next build",
    "start": "next start -p ${PORT:-3007}",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:migrate:sql": "tsx scripts/apply-sql-migrations.ts",
    "db:build-admin-divisions-seed": "tsx scripts/build-admin-divisions-seed.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "docker:up": "docker compose up -d",
    "docker:wait": "tsx scripts/wait-for-postgres.ts",
    "docker:setup": "npm run docker:up && npm run docker:wait && npm run db:migrate:sql && npm run db:seed",
    "docker:setup:fresh": "docker compose down -v && npm run docker:setup",
    "export:github": "bash scripts/sync-followable-github.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@vercel/blob": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.20.1",
    "next": "16.1.6",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "^8.1.0",
    "siwe": "^3.0.0",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.47.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "seedrandom": "^3.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
