# Zkopíruj do .env.local: cp .env.example .env.local

# Postgres z docker-compose (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/followable

# Vynutit demo režim i při nastavené DATABASE_URL
# USE_DEMO_MODE=true

SESSION_SECRET=followable-change-me-in-production

NEXT_PUBLIC_APP_URL=http://localhost:3007

# Mapa (volitelné)
# NEXT_PUBLIC_MAPTILER_KEY=
# NEXT_PUBLIC_MAP_STYLE_URL=
# NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# Geocoding (volitelné)
# MAPBOX_ACCESS_TOKEN=
# NOMINATIM_BASE_URL=

# Uploads — Vercel Blob (volitelné)
# BLOB_READ_WRITE_TOKEN=

# Wallet / platby (volitelné, viz README)
# NEXT_PUBLIC_WALLET_CHAIN_ID=
# NEXT_PUBLIC_WALLET_RPC_URL=
# NEXT_PUBLIC_PAYMENT_RECIPIENT_ADDRESS=
# NEXT_PUBLIC_UNLOCK_RECEIVER=
